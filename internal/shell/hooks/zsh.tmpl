# tq shell hook (zsh)
# The prompt hook is registered first and every function uses the
# `function name { ...; }` form, whose name is never alias-expanded: an
# earlier `alias claude=...` can never abort this block.
function __tq_hook { [ "${TQ_ENABLED:-1}" = "0" ] && return 0; local __o; __o="$(MSYS2_ENV_CONV_EXCL=__TQ_SH_PATH __TQ_SH_PATH="$PATH" {{.Bin}} env --shell zsh 2>/dev/null)"; if [ -n "$__o" ]; then eval "$__o"; fi; return 0; }
autoload -Uz add-zsh-hook 2>/dev/null
if (( ${precmd_functions[(I)__tq_hook]} == 0 )); then precmd_functions+=(__tq_hook); fi
__tq_hook
function tq { {{.Bin}} "$@"; }
function claude { {{.Bin}} run . -- claude "$@"; }
function codex { {{.Bin}} run . -- codex "$@"; }
function claude-off { {{.Bin}} run --off -- claude "$@"; }
function codex-off { {{.Bin}} run --off -- codex "$@"; }
