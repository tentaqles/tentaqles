# tq shell hook (bash)
# The prompt hook is registered first and every function uses the
# `function name { ...; }` form, whose name is never alias-expanded: an
# earlier `alias claude=...` can never abort this block.
function __tq_hook { [ "${TQ_ENABLED:-1}" = "0" ] && return 0; local __o; __o="$(MSYS2_ENV_CONV_EXCL=__TQ_SH_PATH __TQ_SH_PATH="$PATH" {{.Bin}} env --shell bash 2>/dev/null)"; if [ -n "$__o" ]; then eval "$__o"; fi; return 0; }
case ";${PROMPT_COMMAND:-};" in *";__tq_hook;"*) ;; *) PROMPT_COMMAND="__tq_hook${PROMPT_COMMAND:+;$PROMPT_COMMAND}";; esac
__tq_hook
function tentaqles { {{.Bin}} "$@"; }
function tq { {{.Bin}} "$@"; }
function claude { {{.Bin}} run . -- claude "$@"; }
